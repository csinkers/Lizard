<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <PackageReference Include="SerdesNet" Version="4.1.0" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="&quot;$(ProjectDir)\..\..\build\Lizard.CodeGen\bin\$(Configuration)\net9.0\Lizard.CodeGen.exe&quot; $(ProjectDir)\..\LizardProtocol1.lproto -cs -o $(ProjectDir)\Generated -ns Lizard.Comms" />
  </Target>

</Project>
